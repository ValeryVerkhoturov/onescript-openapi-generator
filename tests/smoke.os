// Сквозная проверка сгенерированного клиента: запросы уходят на локальный
// эхо-сервер, который возвращает описание полученного запроса.
//
// Запуск: scripts/smoke.sh

#Использовать "../out-smoke"

Перем Ошибки;

Процедура Проверить(Знач Условие, Знач Описание)
	Если Условие Тогда
		Сообщить("  ok   " + Описание);
	Иначе
		Ошибки = Ошибки + 1;
		Сообщить("  ОШИБКА " + Описание);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьРавно(Знач Фактическое, Знач Ожидаемое, Знач Описание)
	Если Фактическое = Ожидаемое Тогда
		Сообщить("  ok   " + Описание);
	Иначе
		Ошибки = Ошибки + 1;
		Сообщить("  ОШИБКА " + Описание);
		Сообщить("         ожидали: " + Ожидаемое);
		Сообщить("         получили: " + Фактическое);
	КонецЕсли;
КонецПроцедуры

Ошибки = 0;

Настройки = Новый Конфигурация();
Настройки.УстановитьТокен("secret-token-42");
Настройки.ПользовательскийАгент = "generator-smoke-test";

Клиент = Новый ЭхоApi(Настройки);

Сообщить("GET с параметрами строки запроса и заголовком");
// Имя "X-Trace" не является допустимым ключом Структуры, поэтому здесь нужно
// Соответствие — ровно тот случай, ради которого метод принимает обе коллекции.
ДопПараметры = Новый Соответствие;
ДопПараметры.Вставить("q", "поиск/значение");
ДопПараметры.Вставить("X-Trace", "trace-1");

Ответ = Клиент.EchoGet(10, ДопПараметры);
Эхо = Ответ.Данные;
ПроверитьРавно(Ответ.КодСостояния, 200, "код состояния");
ПроверитьРавно(Эхо["method"], "GET", "метод");
ПроверитьРавно(Эхо["path"], "/echo", "путь");
ПроверитьРавно(Эхо["query"]["limit"][0], "10", "обязательный параметр limit");
ПроверитьРавно(Эхо["query"]["q"][0], "поиск/значение", "необязательный параметр q декодируется обратно");
Проверить(СтрНайти(Эхо["rawQuery"], "%2F") > 0, "слэш в значении экранирован");
ПроверитьРавно(Эхо["headers"]["authorization"], "Bearer secret-token-42", "заголовок авторизации");
ПроверитьРавно(Эхо["headers"]["user-agent"], "generator-smoke-test", "заголовок User-Agent");
ПроверитьРавно(Эхо["headers"]["x-trace"], "trace-1", "необязательный параметр ушёл в заголовок, а не в строку запроса");
Проверить(СтрНайти(Эхо["rawQuery"], "X-Trace") = 0, "заголовок не попал в строку запроса");

Сообщить("");
Сообщить("Те же параметры через Структуру");
Ответ = Клиент.EchoGet(5, Новый Структура("q", "простое"));
ПроверитьРавно(Ответ.Данные["query"]["q"][0], "простое", "Структура принимается наравне с Соответствием");
ПроверитьРавно(Ответ.Данные["query"]["limit"][0], "5", "обязательный параметр не потерян");

Сообщить("");
Сообщить("Параметр пути");
Ответ = Клиент.EchoSegment("значение/со слэшем");
ПроверитьРавно(Ответ.Данные["pathDecoded"], "/echo/значение/со слэшем", "после декодирования сегмент совпадает с исходным");
Проверить(СтрНайти(Ответ.Данные["path"], "%2F") > 0, "слэш внутри сегмента экранирован, а не разделяет путь");
Проверить(СтрНайти(Ответ.Данные["path"], "%D0") > 0, "кириллица в сегменте закодирована в UTF-8");

Сообщить("");
Сообщить("POST с телом из модели");
Питомец = Новый Pet();
Питомец.id = "p-1";
Питомец.name = "Барсик";
Метки = Новый Массив;
Метки.Добавить("рыжий");
Питомец.tags = Метки;

Ответ = Клиент.EchoPost(Питомец);
Эхо = Ответ.Данные;
ПроверитьРавно(Эхо["method"], "POST", "метод");
ПроверитьРавно(Эхо["headers"]["content-type"], "application/json", "тип содержимого");

ЧтениеТела = Новый ЧтениеJSON();
ЧтениеТела.УстановитьСтроку(Эхо["body"]);
Тело = ПрочитатьJSON(ЧтениеТела, Истина);
ПроверитьРавно(Тело["id"], "p-1", "поле id сериализовано");
ПроверитьРавно(Тело["name"], "Барсик", "поле name сериализовано");
ПроверитьРавно(Тело["tags"][0], "рыжий", "массив сериализован");
Проверить(Тело.Получить("age") = Неопределено, "незаполненное поле пропущено, а не отправлено как null");

Сообщить("");
Сообщить("Модель заполняется из ответа");
Восстановленный = Новый Pet(Тело);
ПроверитьРавно(Восстановленный.name, "Барсик", "Заполнить() читает имена из спецификации");

Сообщить("");
Сообщить("Секретная строка не раскрывается при выводе");
ПроверитьРавно(Строка(Настройки.Токен()), "СекретнаяСтрока", "Строка() возвращает имя класса");
ПроверитьРавно(Настройки.Токен().Раскрыть(), "secret-token-42", "Раскрыть() возвращает значение");

Сообщить("");
Сообщить("Ошибка 404 приводит к исключению");
Поймали = Ложь;
Попытка
	Клиент.EchoFail();
Исключение
	Поймали = Истина;
	Текст = ОписаниеОшибки();
КонецПопытки;
Проверить(Поймали, "исключение выброшено");
Проверить(СтрНайти(Текст, "404") > 0, "текст исключения содержит код состояния");

Сообщить("");
Сообщить("Без исключения ответ доступен для разбора");
Настройки.ВыбрасыватьИсключениеПриОшибке = Ложь;
Ответ = Клиент.EchoFail();
ПроверитьРавно(Ответ.КодСостояния, 404, "код состояния доступен");
Проверить(Ответ.ЭтоОшибка(), "ЭтоОшибка() истинно");
Проверить(Не Ответ.Успешно(), "Успешно() ложно");

Сообщить("");
Сообщить("Настройки.БазовыйURL перекрывает адрес из спецификации");
ПроверитьРавно(Настройки.БазовыйURL, "", "по умолчанию адрес берётся из спецификации");

Сообщить("");
Если Ошибки = 0 Тогда
	Сообщить("Все проверки пройдены");
Иначе
	Сообщить("Проверок не пройдено: " + Ошибки);
	ЗавершитьРаботу(1);
КонецЕсли;

// Транспорт HTTP: сборка запроса, отправка и разбор ответа.
//
// Используется классами API и обычно не вызывается напрямую.
//
// Класс сформирован автоматически ({{generatorName}}). Правки будут потеряны.

Перем Настройки;

Процедура ПриСозданииОбъекта(Знач ВходящиеНастройки)
	Настройки = ВходящиеНастройки;
КонецПроцедуры

// Выполняет запрос к сервису.
//
// Параметры:
//   Метод            - Строка        - метод HTTP, например "GET".
//   Ресурс           - Строка        - путь ресурса, начиная со слэша.
//   ПараметрыЗапроса - Соответствие  - параметры строки запроса.
//   Заголовки        - Соответствие  - заголовки запроса.
//   Тело             - Произвольный  - тело запроса или Неопределено.
//   БазовыйURL       - Строка        - адрес сервиса, если он отличается от общего.
//
// Возвращаемое значение:
//   ОтветAPI
//
Функция ВыполнитьЗапрос(Знач Метод, Знач Ресурс, Знач ПараметрыЗапроса = Неопределено,
	Знач Заголовки = Неопределено, Знач Тело = Неопределено, Знач БазовыйURL = "") Экспорт

	// Явно заданный адрес в настройках важнее того, что зашит в операцию:
	// иначе клиент нельзя было бы перенаправить на песочницу или тестовый стенд.
	Адрес = ?(ЗначениеЗаполнено(Настройки.БазовыйURL), Настройки.БазовыйURL, БазовыйURL);
	РазобранныйАдрес = РазобратьАдрес(Адрес);

	ПолныйРесурс = РазобранныйАдрес.Префикс + Ресурс + СобратьСтрокуЗапроса(ПараметрыЗапроса);

	Соединение = Новый HTTPСоединение(
		РазобранныйАдрес.Сервер,
		РазобранныйАдрес.Порт,
		,
		,
		Настройки.Прокси,
		Настройки.Таймаут);

	Запрос = Новый HTTPЗапрос(ПолныйРесурс);

	Запрос.Заголовки.Вставить("Accept", "application/json");
	Запрос.Заголовки.Вставить("User-Agent", Настройки.ПользовательскийАгент);

	Если Не Настройки.Токен().Пустая() Тогда
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Настройки.Токен().Раскрыть());
	КонецЕсли;

	ДобавитьЗаголовки(Запрос, Настройки.ДополнительныеЗаголовки);
	ДобавитьЗаголовки(Запрос, Заголовки);

	Если Тело <> Неопределено Тогда
		Если Запрос.Заголовки.Получить("Content-Type") = Неопределено Тогда
			Запрос.Заголовки.Вставить("Content-Type", "application/json");
		КонецЕсли;
		Запрос.УстановитьТелоИзСтроки(СериализоватьТело(Тело), КодировкаТекста.UTF8);
	КонецЕсли;

	Ответ = Новый ОтветAPI(Соединение.ВызватьHTTPМетод(ВРег(Метод), Запрос));

	Если Настройки.ВыбрасыватьИсключениеПриОшибке И Ответ.ЭтоОшибка() Тогда
		ВызватьИсключение ТекстОшибки(ВРег(Метод), ПолныйРесурс, Ответ);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Раскладывает необязательные параметры по строке запроса и заголовкам.
//
// Параметры:
//   ДопПараметры     - Структура, Соответствие - переданные вызывающим кодом значения.
//   ИменаЗаголовков  - Массив                  - имена параметров, которые являются заголовками.
//   ПараметрыЗапроса - Соответствие            - приёмник параметров строки запроса.
//   Заголовки        - Соответствие            - приёмник заголовков.
//
Процедура РазложитьПараметры(Знач ДопПараметры, Знач ИменаЗаголовков, ПараметрыЗапроса, Заголовки) Экспорт

	Если ДопПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементПараметра Из ДопПараметры Цикл

		Имя = Строка(ЭлементПараметра.Ключ);
		Значение = ЭлементПараметра.Значение;

		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЭтоЗаголовок(Имя, ИменаЗаголовков) Тогда
			Заголовки.Вставить(Имя, Значение);
		Иначе
			ПараметрыЗапроса.Вставить(Имя, Значение);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Кодирует значение для подстановки в путь ресурса.
//
// Параметры:
//   Значение - Произвольный - значение параметра пути.
//
// Возвращаемое значение:
//   Строка
//
Функция ЭкранироватьСегмент(Знач Значение) Экспорт
	Возврат КодироватьСтроку(ВСтроку(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ЭтоЗаголовок(Знач Имя, Знач ИменаЗаголовков)

	Если ИменаЗаголовков = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Искомое = НРег(Имя);

	Для Каждого ИмяЗаголовка Из ИменаЗаголовков Цикл
		Если НРег(ИмяЗаголовка) = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьЗаголовки(Запрос, Знач Источник)

	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементЗаголовка Из Источник Цикл
		Если ЭлементЗаголовка.Значение <> Неопределено Тогда
			Запрос.Заголовки.Вставить(Строка(ЭлементЗаголовка.Ключ), ВСтроку(ЭлементЗаголовка.Значение));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Разбирает адрес вида scheme://host[:port][/префикс].
//
// HTTPСоединение в OneScript принимает схему прямо в имени сервера — именно так
// включается HTTPS, отдельного параметра защищённого соединения здесь нет.
Функция РазобратьАдрес(Знач Адрес)

	Результат = Новый Структура("Сервер, Порт, Префикс");
	Результат.Порт = Неопределено;
	Результат.Префикс = "";

	Остаток = СокрЛП(Адрес);
	Схема = "";

	ПозицияСхемы = СтрНайти(Остаток, "://");
	Если ПозицияСхемы > 0 Тогда
		Схема = Лев(Остаток, ПозицияСхемы + 2);
		Остаток = Сред(Остаток, ПозицияСхемы + 3);
	КонецЕсли;

	ПозицияПути = СтрНайти(Остаток, "/");
	Если ПозицияПути > 0 Тогда
		Результат.Префикс = Сред(Остаток, ПозицияПути);
		Остаток = Лев(Остаток, ПозицияПути - 1);
	КонецЕсли;

	Пока СтрЗаканчиваетсяНа(Результат.Префикс, "/") Цикл
		Результат.Префикс = Лев(Результат.Префикс, СтрДлина(Результат.Префикс) - 1);
	КонецЦикла;

	ПозицияПорта = СтрНайти(Остаток, ":");
	Если ПозицияПорта > 0 Тогда
		ТекстПорта = Сред(Остаток, ПозицияПорта + 1);
		Остаток = Лев(Остаток, ПозицияПорта - 1);
		Попытка
			Результат.Порт = Число(ТекстПорта);
		Исключение
			Результат.Порт = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Результат.Сервер = Схема + Остаток;

	Возврат Результат;

КонецФункции

Функция СобратьСтрокуЗапроса(Знач ПараметрыЗапроса)

	Если ПараметрыЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;

	Для Каждого ЭлементПараметра Из ПараметрыЗапроса Цикл

		Имя = КодироватьСтроку(Строка(ЭлементПараметра.Ключ), СпособКодированияСтроки.КодировкаURL);
		Значение = ЭлементПараметра.Значение;

		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			// Повторяющийся ключ — форма collectionFormat=multi, принятая по умолчанию.
			Для Каждого ЭлементМассива Из Значение Цикл
				Части.Добавить(Имя + "=" + КодироватьСтроку(ВСтроку(ЭлементМассива), СпособКодированияСтроки.КодировкаURL));
			КонецЦикла;
		Иначе
			Части.Добавить(Имя + "=" + КодироватьСтроку(ВСтроку(Значение), СпособКодированияСтроки.КодировкаURL));
		КонецЕсли;

	КонецЦикла;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "?" + СтрСоединить(Части, "&");

КонецФункции

Функция СериализоватьТело(Знач Тело)

	Если ТипЗнч(Тело) = Тип("Строка") Тогда
		Возврат Тело;
	КонецЕсли;

	Значение = Тело;

	// Модели знают, как разложить себя в Соответствие.
	Попытка
		Значение = Тело.Данные();
	Исключение
		Значение = Тело;
	КонецПопытки;

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

Функция ВСтроку(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧН=");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ТекстОшибки(Знач Метод, Знач Ресурс, Знач Ответ)

	// Исключение несёт текст, а не объект: ВызватьИсключение в OneScript не
	// сохраняет объект для перехватчика. Если нужен разбор ответа по полям,
	// выключите Настройки.ВыбрасыватьИсключениеПриОшибке и читайте ОтветAPI.
	Выдержка = Ответ.Тело;
	Если СтрДлина(Выдержка) > 500 Тогда
		Выдержка = Лев(Выдержка, 500) + "…";
	КонецЕсли;

	Возврат СтрШаблон("HTTP %1 — %2 %3%4%5",
		Формат(Ответ.КодСостояния, "ЧГ=0; ЧН="),
		Метод,
		Ресурс,
		?(Выдержка = "", "", ": "),
		Выдержка);

КонецФункции

#КонецОбласти

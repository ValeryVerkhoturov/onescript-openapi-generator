// Транспорт HTTP: сборка запроса, отправка и разбор ответа.
//
// Построен на библиотеке [1connector](https://github.com/vbondarevsky/1connector):
// она собирает и кодирует строку запроса, сериализует тело в JSON, разбирает
// ответ, умеет повторять запросы и работать с прокси и SSL.
//
// Используется классами API и обычно не вызывается напрямую.
//
// Класс сформирован автоматически ({{generatorName}}). Правки будут потеряны.

#Использовать 1connector

Перем Настройки;

Процедура ПриСозданииОбъекта(Знач ВходящиеНастройки)
	Настройки = ВходящиеНастройки;
КонецПроцедуры

// Выполняет запрос к сервису.
//
// Параметры:
//   Метод            - Строка        - метод HTTP, например "GET".
//   Ресурс           - Строка        - путь ресурса, начиная со слэша.
//   ПараметрыЗапроса - Соответствие  - параметры строки запроса.
//   Заголовки        - Соответствие  - заголовки запроса.
//   Тело             - Произвольный  - тело запроса или Неопределено.
//   БазовыйURL       - Строка        - адрес сервиса, если он отличается от общего.
//
// Возвращаемое значение:
//   ОтветAPI
//
Функция ВыполнитьЗапрос(Знач Метод, Знач Ресурс, Знач ПараметрыЗапроса = Неопределено,
	Знач Заголовки = Неопределено, Знач Тело = Неопределено, Знач БазовыйURL = "") Экспорт

	// Явно заданный адрес в настройках важнее того, что зашит в операцию:
	// иначе клиент нельзя было бы перенаправить на песочницу или тестовый стенд.
	Адрес = ?(ЗначениеЗаполнено(Настройки.БазовыйURL), Настройки.БазовыйURL, БазовыйURL);

	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Заголовки", СобратьЗаголовки(Заголовки));
	ДополнительныеПараметры.Вставить("Таймаут", Настройки.Таймаут);
	ДополнительныеПараметры.Вставить("ПроверятьSSL", Настройки.ПроверятьSSL);

	// Параметры строки запроса 1connector кодирует сам, включая повторяющиеся
	// ключи для значений-массивов.
	Если ПараметрыЗапроса <> Неопределено И ПараметрыЗапроса.Количество() > 0 Тогда
		ДополнительныеПараметры.Вставить("ПараметрыЗапроса", ОчиститьПараметры(ПараметрыЗапроса));
	КонецЕсли;

	Если Настройки.Прокси <> Неопределено Тогда
		ДополнительныеПараметры.Вставить("Прокси", Настройки.Прокси);
	КонецЕсли;

	// Повторы: у сервиса могут быть лимиты запросов, и 429 разумнее переждать,
	// чем возвращать вызывающему коду.
	Если Настройки.МаксимальноеКоличествоПовторов > 0 Тогда
		ДополнительныеПараметры.Вставить("МаксимальноеКоличествоПовторов", Настройки.МаксимальноеКоличествоПовторов);
		ДополнительныеПараметры.Вставить("ПовторятьДляКодовСостояний", Настройки.ПовторятьДляКодовСостояний);
	КонецЕсли;

	ДобавитьТело(ДополнительныеПараметры, Тело);

	Ответ = Новый ОтветAPI(КоннекторHTTP.ВызватьМетод(ВРег(Метод), Адрес + Ресурс, ДополнительныеПараметры));

	Если Настройки.ВыбрасыватьИсключениеПриОшибке И Ответ.ЭтоОшибка() Тогда
		ВызватьИсключение ТекстОшибки(ВРег(Метод), Ответ);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Раскладывает необязательные параметры по строке запроса и заголовкам.
//
// Параметры:
//   ДопПараметры     - Структура, Соответствие - переданные вызывающим кодом значения.
//   ИменаЗаголовков  - Массив                  - имена параметров, которые являются заголовками.
//   ПараметрыЗапроса - Соответствие            - приёмник параметров строки запроса.
//   Заголовки        - Соответствие            - приёмник заголовков.
//
Процедура РазложитьПараметры(Знач ДопПараметры, Знач ИменаЗаголовков, ПараметрыЗапроса, Заголовки) Экспорт

	Если ДопПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементПараметра Из ДопПараметры Цикл

		Имя = Строка(ЭлементПараметра.Ключ);
		Значение = ЭлементПараметра.Значение;

		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЭтоЗаголовок(Имя, ИменаЗаголовков) Тогда
			Заголовки.Вставить(Имя, Значение);
		Иначе
			ПараметрыЗапроса.Вставить(Имя, Значение);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Кодирует значение для подстановки в путь ресурса.
//
// Параметры строки запроса кодирует сам 1connector, а вот сегменты пути
// подставляются в URL до его разбора, поэтому их экранируем здесь.
//
// Параметры:
//   Значение - Произвольный - значение параметра пути.
//
// Возвращаемое значение:
//   Строка
//
Функция ЭкранироватьСегмент(Знач Значение) Экспорт
	Возврат КодироватьСтроку(ВСтроку(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция СобратьЗаголовки(Знач Заголовки)

	Результат = Новый Соответствие;
	Результат.Вставить("Accept", "application/json");
	Результат.Вставить("User-Agent", Настройки.ПользовательскийАгент);

	Если Не Настройки.Токен().Пустая() Тогда
		Результат.Вставить("Authorization", "Bearer " + Настройки.Токен().Раскрыть());
	КонецЕсли;

	ДобавитьЗаголовки(Результат, Настройки.ДополнительныеЗаголовки);
	ДобавитьЗаголовки(Результат, Заголовки);

	Возврат Результат;

КонецФункции

Процедура ДобавитьЗаголовки(Приёмник, Знач Источник)

	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ЭлементЗаголовка Из Источник Цикл
		Если ЭлементЗаголовка.Значение <> Неопределено Тогда
			Приёмник.Вставить(Строка(ЭлементЗаголовка.Ключ), ВСтроку(ЭлементЗаголовка.Значение));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОчиститьПараметры(Знач ПараметрыЗапроса)

	Результат = Новый Соответствие;

	Для Каждого ЭлементПараметра Из ПараметрыЗапроса Цикл

		Значение = ЭлементПараметра.Значение;

		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			// Массив 1connector разворачивает в повторяющийся ключ.
			Элементы = Новый Массив;
			Для Каждого ЭлементМассива Из Значение Цикл
				Элементы.Добавить(ВСтроку(ЭлементМассива));
			КонецЦикла;
			Результат.Вставить(Строка(ЭлементПараметра.Ключ), Элементы);
		Иначе
			Результат.Вставить(Строка(ЭлементПараметра.Ключ), ВСтроку(Значение));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьТело(ДополнительныеПараметры, Знач Тело)

	Если Тело = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Строку и двоичные данные отправляем как есть: вызывающий код уже решил,
	// в каком виде их передать, и Content-Type может быть выставлен вручную.
	Если ТипЗнч(Тело) = Тип("Строка") ИЛИ ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		ДополнительныеПараметры.Вставить("Данные", Тело);
		Возврат;
	КонецЕсли;

	// Остальное уходит как JSON — сериализацию и Content-Type берёт на себя
	// 1connector. Модели предварительно раскладываются в Соответствие.
	ДополнительныеПараметры.Вставить("Json", ЗначениеДляJson(Тело));

КонецПроцедуры

Функция ЗначениеДляJson(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЗначениеДляJson(ЭлементМассива));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	// Модели знают, как разложить себя в Соответствие.
	Попытка
		Возврат Значение.Данные();
	Исключение
		Возврат Значение;
	КонецПопытки;

КонецФункции

Функция ЭтоЗаголовок(Знач Имя, Знач ИменаЗаголовков)

	Если ИменаЗаголовков = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Искомое = НРег(Имя);

	Для Каждого ИмяЗаголовка Из ИменаЗаголовков Цикл
		Если НРег(ИмяЗаголовка) = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ВСтроку(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧН=");
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция ТекстОшибки(Знач Метод, Знач Ответ)

	// Исключение несёт текст, а не объект: ВызватьИсключение в OneScript не
	// сохраняет объект для перехватчика. Если нужен разбор ответа по полям,
	// выключите Настройки.ВыбрасыватьИсключениеПриОшибке и читайте ОтветAPI.
	Выдержка = Ответ.Тело;
	Если СтрДлина(Выдержка) > 500 Тогда
		Выдержка = Лев(Выдержка, 500) + "…";
	КонецЕсли;

	Возврат СтрШаблон("HTTP %1 — %2 %3%4%5",
		Формат(Ответ.КодСостояния, "ЧГ=0; ЧН="),
		Метод,
		Ответ.URL,
		?(Выдержка = "", "", ": "),
		Выдержка);

КонецФункции

#КонецОбласти

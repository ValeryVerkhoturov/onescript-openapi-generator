// Обёртка над секретной строкой (например, токеном доступа).
//
// Значение хранится в неэкспортируемой переменной, поэтому не попадает ни в
// вывод Сообщить(), ни в сериализацию объекта: Строка(Объект) возвращает только
// имя класса. Чтобы получить само значение, его нужно запросить явно — Раскрыть().
//
// Пример:
//   Токен = Новый СекретнаяСтрока("eyJhbGciOi...");
//   Сообщить(Токен);            // СекретнаяСтрока
//   Сообщить(Токен.Раскрыть()); // eyJhbGciOi...
//
// Класс сформирован автоматически ({{generatorName}}). Правки будут потеряны.

Перем ЗакрытоеЗначение;

Процедура ПриСозданииОбъекта(Знач Значение = "")

	Если Значение = Неопределено Тогда
		ЗакрытоеЗначение = "";
	ИначеЕсли ТипЗнч(Значение) = Тип("СекретнаяСтрока") Тогда
		ЗакрытоеЗначение = Значение.Раскрыть();
	Иначе
		ЗакрытоеЗначение = Строка(Значение);
	КонецЕсли;

КонецПроцедуры

// Возвращает защищённое значение.
//
// Возвращаемое значение:
//   Строка
//
Функция Раскрыть() Экспорт
	Возврат ЗакрытоеЗначение;
КонецФункции

// Признак того, что значение не задано.
//
// Возвращаемое значение:
//   Булево
//
Функция Пустая() Экспорт
	Возврат ЗакрытоеЗначение = "";
КонецФункции

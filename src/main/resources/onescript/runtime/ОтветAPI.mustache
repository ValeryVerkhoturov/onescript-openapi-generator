// Ответ сервиса: код состояния, заголовки, тело и разобранный JSON.
//
// Обёртка над `ПодготовленныйОтвет` из [1connector](https://github.com/vbondarevsky/1connector).
// Исходный объект доступен в свойстве `Источник` — там же лежат Cookies,
// время выполнения и признаки перенаправления.
//
// Класс сформирован автоматически ({{generatorName}}). Правки будут потеряны.

// Число - код состояния HTTP
Перем КодСостояния Экспорт;
// Соответствие - заголовки ответа
Перем Заголовки Экспорт;
// Строка - адрес, по которому был получен ответ, вместе со строкой запроса
Перем URL Экспорт;
// Строка - тело ответа как есть
Перем Тело Экспорт;
// Произвольный - тело, разобранное из JSON, либо Неопределено
Перем Данные Экспорт;
// ПодготовленныйОтвет - исходный ответ 1connector
Перем Источник Экспорт;

Процедура ПриСозданииОбъекта(Знач ОтветКоннектора)

	Источник = ОтветКоннектора;
	КодСостояния = ОтветКоннектора.КодСостояния;
	Заголовки = ОтветКоннектора.Заголовки;
	URL = ОтветКоннектора.URL;

	Попытка
		Тело = ОтветКоннектора.Текст();
	Исключение
		Тело = "";
	КонецПопытки;

	Если Тело = Неопределено Тогда
		Тело = "";
	КонецЕсли;

	Данные = РазобратьJSON(ОтветКоннектора);

КонецПроцедуры

// Признак успешного ответа (код 2xx).
//
// Возвращаемое значение:
//   Булево
//
Функция Успешно() Экспорт
	Возврат КодСостояния >= 200 И КодСостояния < 300;
КонецФункции

// Признак ответа с ошибкой (код 4xx или 5xx).
//
// Возвращаемое значение:
//   Булево
//
Функция ЭтоОшибка() Экспорт
	Возврат КодСостояния >= 400;
КонецФункции

// Возвращает значение заголовка без учёта регистра имени.
//
// Параметры:
//   Имя - Строка - имя заголовка.
//
// Возвращаемое значение:
//   Строка, Неопределено
//
Функция Заголовок(Знач Имя) Экспорт

	Искомое = НРег(Имя);

	Для Каждого ЭлементЗаголовка Из Заголовки Цикл
		Если НРег(Строка(ЭлементЗаголовка.Ключ)) = Искомое Тогда
			Возврат ЭлементЗаголовка.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает тело ответа как двоичные данные.
//
// Нужно для методов, отдающих файл — отчёт, накладную, изображение.
//
// Возвращаемое значение:
//   ДвоичныеДанные
//
Функция ДвоичныеДанные() Экспорт
	Возврат Источник.ДвоичныеДанные();
КонецФункции

Функция РазобратьJSON(Знач ОтветКоннектора)

	Если СокрЛП(Тело) = "" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ОтветКоннектора.Json();
	Исключение
		// Тело не JSON (text/plain, application/zip и подобные) — остаётся в Тело.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

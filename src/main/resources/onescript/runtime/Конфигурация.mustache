// Настройки клиента: адрес сервиса, токен доступа, таймаут и заголовки по умолчанию.
//
// Пример:
//   Настройки = Новый Конфигурация();
//   Настройки.УстановитьТокен("eyJhbGciOi...");
//   Клиент = Новый {{#apiInfo}}{{#apis}}{{#-first}}{{classname}}{{/-first}}{{/apis}}{{/apiInfo}}(Настройки);
//
// Класс сформирован автоматически ({{generatorName}}). Правки будут потеряны.

// Базовый адрес сервиса. Пустая строка означает «брать адрес из спецификации»:
// у каждой операции он свой, если в документе заданы серверы на уровне пути.
// Заполните это свойство, чтобы направить все запросы на другой хост,
// например на песочницу.
{{#osDefaultBaseUrl}}// Адрес по умолчанию из спецификации — {{{osDefaultBaseUrl}}}
{{/osDefaultBaseUrl}}Перем БазовыйURL Экспорт;
// Таймаут запроса в секундах
Перем Таймаут Экспорт;
// Значение заголовка User-Agent
Перем ПользовательскийАгент Экспорт;
// Соответствие: заголовки, добавляемые к каждому запросу
Перем ДополнительныеЗаголовки Экспорт;
// ИнтернетПрокси или Неопределено
Перем Прокси Экспорт;
// Если Истина, ответы с кодом 4xx и 5xx приводят к исключению
Перем ВыбрасыватьИсключениеПриОшибке Экспорт;

Перем ЗакрытыйТокен;

Процедура ПриСозданииОбъекта(Знач АдресСервиса = "")

	БазовыйURL = АдресСервиса;
	Таймаут = 60;
	ПользовательскийАгент = "{{{userAgent}}}";
	ДополнительныеЗаголовки = Новый Соответствие;
	Прокси = Неопределено;
	ВыбрасыватьИсключениеПриОшибке = Истина;
	ЗакрытыйТокен = Новый СекретнаяСтрока("");

КонецПроцедуры

// Устанавливает токен доступа (схема Bearer).
//
// Параметры:
//   Токен - Строка, СекретнаяСтрока - значение токена.
//
Процедура УстановитьТокен(Знач Токен) Экспорт

	Если ТипЗнч(Токен) = Тип("СекретнаяСтрока") Тогда
		ЗакрытыйТокен = Токен;
	Иначе
		ЗакрытыйТокен = Новый СекретнаяСтрока(Токен);
	КонецЕсли;

КонецПроцедуры

// Возвращает токен доступа в защищённой обёртке.
//
// Возвращаемое значение:
//   СекретнаяСтрока
//
Функция Токен() Экспорт
	Возврат ЗакрытыйТокен;
КонецФункции

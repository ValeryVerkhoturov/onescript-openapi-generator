// Проверяет заполненные значения по схеме.
//
// Проверка добровольная: ни конструктор, ни транспорт её не вызывают, поэтому
// поведение запросов не меняется, пока вызывающий код сам не попросит.
//
// Возвращаемое значение:
//   JsonSchemaResult - свойства `Корректно` и `Ошибки`; у ошибки есть `Путь`
//                      (указатель JSON), `Ключевое`, `Сообщение` и `Значение`.
//
// Пример:
//   Результат = Модель.Проверить();
//   Если Не Результат.Корректно Тогда
//   	Для Каждого Ошибка Из Результат.Ошибки Цикл
//   		Сообщить(Ошибка.Путь + ": " + Ошибка.Сообщение);
//   	КонецЦикла;
//   КонецЕсли;
//
Функция Проверить() Экспорт

	Если СкомпилированнаяСхема = Неопределено Тогда
		// Компиляция схемы заметно дороже самой проверки, поэтому результат
		// кэшируется на экземпляре.
		СкомпилированнаяСхема = JsonSchema.Скомпилировать(JsonSchema.ИзJson(Схема()));
	КонецЕсли;

	Возврат СкомпилированнаяСхема.Проверить(Данные());

КонецФункции

// Признак того, что заполненные значения соответствуют схеме.
//
// Возвращаемое значение:
//   Булево
//
Функция Корректно() Экспорт
	Возврат Проверить().Корректно;
КонецФункции

